# ============================================================
# Bountly — environment variables
# Copy this file to ".env" and fill in real values.
# On Railway/host, set these in the dashboard (do NOT commit .env).
# ============================================================

# Telegram bot token from @BotFather. REQUIRED in production.
# Without it the server runs in insecure DEV mode (auth bypassed),
# which is refused when NODE_ENV=production.
BOT_TOKEN=

# Comma-separated Telegram user IDs that get admin powers in the mini app.
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Password for the web dashboard at /admin (separate from Telegram admin).
# Use a long random string. If empty, the dashboard is disabled.
ADMIN_PASSWORD=

# Deep link shown in notification buttons, e.g. https://t.me/getbountlybot/arena
APP_LINK=

# Postgres connection string. If set, state is stored in Postgres;
# otherwise it falls back to a local data.json file.
DATABASE_URL=

# Set to 1 if your Postgres requires SSL with a self-signed cert (e.g. Railway).
PGSSL=

# Port to listen on (host usually sets this automatically).
PORT=3000

# Set to "production" on your live host. Enables strict mode:
# refuses to start without BOT_TOKEN, disables the dev auth bypass.
NODE_ENV=

# Optional: allow cross-origin API calls from this exact origin.
# Leave empty for a same-origin Telegram mini app (recommended).
# Example: ALLOW_ORIGIN=https://yourdomain.com
ALLOW_ORIGIN=

# Optional: custom directory for uploaded videos (default: ./uploads)
UPLOAD_DIR=
