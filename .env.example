# ============================================================
# Bountly — environment variables
# Copy this file to ".env" and fill in real values.
# On Railway/host, set these in the dashboard (do NOT commit .env).
#
# Only the CORE block is needed to run. Everything below it is opt-in:
# the ledger and the two chains stay completely off unless you turn
# them on.
# ============================================================

# ---------------- CORE ----------------

# Telegram bot token from @BotFather. REQUIRED in production.
# Without it the server runs in insecure DEV mode (auth bypassed),
# which is refused when NODE_ENV=production.
BOT_TOKEN=

# Comma-separated Telegram user IDs that get admin powers in the mini app.
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Password for the web dashboard at /admin (separate from Telegram admin).
# Use a long random string. If empty, the dashboard is disabled.
ADMIN_PASSWORD=

# Public https origin of this deployment, no trailing slash.
# Used to register the Telegram webhook. If empty the webhook is NOT
# registered and bot commands (/start, /howitworks) will not work.
# Example: PUBLIC_URL=https://bountly.example.com
PUBLIC_URL=

# Deep link shown in notification buttons, e.g. https://t.me/getbountlybot/arena
# Falls back to PUBLIC_URL + /app when empty.
APP_LINK=

# Postgres connection string. If set, state is stored in Postgres;
# otherwise it falls back to a local JSON file (see DATA_FILE).
DATABASE_URL=

# Set to 1 if your Postgres requires SSL with a self-signed cert (e.g. Railway).
PGSSL=

# Port to listen on (host usually sets this automatically).
PORT=3000

# Set to "production" on your live host. Enables strict mode:
# refuses to start without BOT_TOKEN, disables the dev auth bypass.
NODE_ENV=

# Optional: allow cross-origin API calls from this exact origin.
# Leave empty for a same-origin Telegram mini app (recommended).
# Example: ALLOW_ORIGIN=https://yourdomain.com
ALLOW_ORIGIN=

# ---------------- STORAGE ----------------

# Directory for uploaded video proofs (default: ./uploads).
# NOTE: on Railway/Docker the container filesystem is ephemeral — anything
# written here is LOST on every redeploy. Mount a volume, or move uploads to
# object storage, before you rely on proofs surviving a deploy.
UPLOAD_DIR=

# Path to the JSON store used when DATABASE_URL is empty (default: ./data.json).
# Point this outside the source tree so state never lands in a build.
DATA_FILE=

# ---------------- DARES ----------------

# Default deadline, in days, for a newly posted dare. When it passes with no
# winner the creator's escrow is refunded automatically. Creators can override
# per dare (1..365). Set to 0 for "no deadline by default" — but then nothing
# ever releases the escrow behind an abandoned dare.
DARE_TTL_DAYS=14

# How long, in hours, after a rejection a hunter may appeal it once. During an
# open dispute the contested slot is held and the dare will not expire.
APPEAL_WINDOW_HOURS=48

# ---------------- LEDGER (opt-in) ----------------

# Set to 1 to route money and dares through the double-entry ledger instead of
# the legacy JSON blob. Requires DATABASE_URL. Migrates app_state on first
# boot; the migration refuses to run twice.
LEDGER=

# ---------------- TON deposits (opt-in, needs LEDGER=1) ----------------

# testnet | mainnet. Validate on testnet before touching real funds.
TON_NETWORK=testnet

# toncenter API base + key. Defaults follow TON_NETWORK when empty.
TON_API=
TON_API_KEY=

# The platform address users send USDT to. A deposit is matched to a user by
# the text comment on the transfer (= their @username).
DEPOSIT_ADDRESS=

# Jetton master address for USDT on the chosen network.
USDT_JETTON_MASTER=

# Decimals of the jetton above (USDT = 6).
USDT_DECIMALS=6

# How deep the masterchain block holding a transfer must be before it is
# credited. TON finalises in one block, so 1 is the honest default; raise it
# if you want a bigger margin. Until a transfer reaches this depth the player
# sees it as "confirming" and no money moves.
TON_MIN_CONFIRMATIONS=1

# Mnemonic of the wallet that signs WITHDRAWALS. Highly sensitive — it can move
# funds. Set it yourself; never paste it into a chat or a commit. Leave empty
# unless you are actually sending on-chain.
WALLET_MNEMONIC=

# ---------------- Solana deposits (opt-in, needs LEDGER=1) ----------------

# Set to 1 to enable per-user Solana USDC deposit addresses.
SOLANA=

# devnet | mainnet. Validate on devnet first.
SOLANA_NETWORK=devnet

# Helius API key + RPC. SOLANA_RPC defaults to Helius for the chosen network.
HELIUS_API_KEY=
SOLANA_RPC=

# Shared secret checked against the Helius webhook's Authorization header.
# Required — the webhook fails closed without it.
HELIUS_WEBHOOK_SECRET=

# Optional: Helius webhook id. When set, newly allocated deposit addresses are
# added to its watch list automatically; otherwise register them by hand.
# Deposits are detected either way — without a webhook the server finds them
# by polling the cluster instead, just a little later.
HELIUS_WEBHOOK_ID=

# Master mnemonic every per-user deposit address is derived from
# (m/44'/501'/<i>'/0'). Highly sensitive — it controls every deposit address
# AND the hot wallet at index 0. Set it yourself.
SOLANA_MASTER_MNEMONIC=

# Canonical USDC mint + decimals. Defaults follow SOLANA_NETWORK. A wrong mint
# here means look-alike tokens could be credited as real USDC.
USDC_MINT=
USDC_DECIMALS=6

# Ignore deposits smaller than this, in USDC.
MIN_DEPOSIT_USDC=0.5
